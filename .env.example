# Exemplo de arquivo de variáveis de ambiente (.env)
# Copie este arquivo para .env e preencha com suas chaves privadas.

# Chave da API do Google AI (Gemini / AI Studio)
# Obtenha no Google Cloud / AI Studio (instruções no README)
LLM_API_KEY=your_google_ai_studio_api_key_here

# (Opcional) Chave da OpenAI — só necessária se você quiser usar OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Modelo Gemini a usar (exemplos): models/gemini-3.6-flash
# Se não informado, o serviço tentará um padrão compatível.
GEMINI_MODEL=models/gemini-3.6-flash

# Porta onde o servidor rodará
PORT=3000
